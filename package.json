{
  "name": "techlahoma-google-apps-starter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:doctor": "bun scripts/setup-doctor.ts",
    "skills:plan": "bun scripts/planning-skills.ts plan",
    "skills:apply": "bun scripts/planning-skills.ts apply",
    "skills:check": "bun scripts/planning-skills.ts check",
    "dev": "bun run --cwd apps/welcome dev",
    "build": "bun scripts/workspace-apps.ts build",
    "app:create": "bun scripts/create-app.ts",
    "app:verify": "bun scripts/verify-app.ts",
    "app:browser:verify": "bun scripts/verify-browser.ts",
    "browser:install": "playwright install chromium",
    "agent:finish": "bun scripts/agent-finish.ts",
    "apps:check": "bun scripts/workspace-apps.ts check",
    "deploy": "bun scripts/deploy.ts",
    "preview": "bun run --cwd apps/welcome preview",
    "test": "bun test tests",
    "audit:dependencies": "bun audit",
    "format": "NODE_PATH=./node_modules gts fix 'scripts/**/*.ts' 'tests/**/*.ts' 'apps/*/src/**/*.{ts,tsx}' 'templates/vite-app/src/**/*.ts' && biome format --write .",
    "format:check": "biome format .",
    "lint": "NODE_PATH=./node_modules gts lint 'scripts/**/*.ts' 'tests/**/*.ts' 'apps/*/src/**/*.{ts,tsx}' 'templates/vite-app/src/**/*.ts' && biome lint .",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run apps:check",
    "verify": "bun scripts/verify-repository.ts",
    "firebase:login": "NO_UPDATE_NOTIFIER=1 firebase login",
    "firebase:serve": "NO_UPDATE_NOTIFIER=1 firebase emulators:start --only hosting --project demo-techlahoma-google-apps --config apps/welcome/firebase.json",
    "google:doctor": "bun scripts/google-cloud.ts doctor",
    "google:config": "bun scripts/google-cloud.ts config",
    "google:provision": "bun scripts/google-cloud.ts provision",
    "google:sites": "bun scripts/google-cloud.ts sites",
    "google:deploy": "bun scripts/google-cloud.ts deploy",
    "google:deploy-all": "bun scripts/google-cloud.ts deploy-all",
    "google:sites:destroy": "bun scripts/google-cloud.ts sites:destroy",
    "google:destroy": "bun scripts/google-cloud.ts destroy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@firebase/app": "^0.16.0",
    "@firebase/database": "^1.1.4",
    "@types/bun": "1.3.14",
    "eslint": "9.37.0",
    "firebase-tools": "15.24.0",
    "globals": "14.0.0",
    "gts": "7.0.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "skills-lock": "https://codeload.github.com/luisalima/skills-lock/tar.gz/4e37719a163b6022d4a2828850567421f9de7825",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "skills": {
    "setup-matt-pocock-skills": {
      "source": "mattpocock/skills#5beb35b040e3de97e54fa9e386d7e42d15c295c2",
      "path": "skills/engineering/setup-matt-pocock-skills"
    },
    "to-spec": {
      "source": "mattpocock/skills#5beb35b040e3de97e54fa9e386d7e42d15c295c2",
      "path": "skills/engineering/to-spec"
    },
    "to-tickets": {
      "source": "mattpocock/skills#5beb35b040e3de97e54fa9e386d7e42d15c295c2",
      "path": "skills/engineering/to-tickets"
    },
    "handoff": {
      "source": "mattpocock/skills#5beb35b040e3de97e54fa9e386d7e42d15c295c2",
      "path": "skills/productivity/handoff"
    },
    "writing-for-agents": {
      "source": "mattpocock/skills#5beb35b040e3de97e54fa9e386d7e42d15c295c2",
      "path": "skills/productivity/writing-for-agents"
    }
  },
  "skillsConfig": {
    "agents": [
      "universal"
    ]
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
