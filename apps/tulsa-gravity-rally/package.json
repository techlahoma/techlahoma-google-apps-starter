{
  "name": "@techlahoma/tulsa-gravity-rally",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:map": "bun e2e/generate-map-data.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "verify:rules:bundle": "bun build e2e/database-rules.verify.ts --target=node --external @firebase/app --outfile=test-results/database-rules.verify.mjs",
    "verify:rules": "bun run verify:rules:bundle && node test-results/database-rules.verify.mjs",
    "check": "bun run typecheck && bun run typecheck:e2e && bun run test && bun run build"
  },
  "devDependencies": {
    "@firebase/app": "^0.16.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/bun": "1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.4",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@firebase/auth": "^1.13.4",
    "@firebase/component": "^0.7.4",
    "@firebase/database": "^1.1.4",
    "@firebase/logger": "^0.5.1",
    "@firebase/util": "^1.15.2",
    "dijkstrajs": "^1.0.3",
    "firebase": "^12.17.1",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "three": "^0.185.1"
  }
}
