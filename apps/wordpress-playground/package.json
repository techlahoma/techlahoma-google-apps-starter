{
  "name": "@techlahoma/wordpress-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build",
    "start": "node scripts/serve.mjs",
    "export:aistudio": "node scripts/export-aistudio.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "mcp": "node scripts/mcp.mjs"
  },
  "dependencies": {
    "@wp-playground/client": "3.1.58",
    "@wp-playground/mcp": "3.1.58",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  }
}
