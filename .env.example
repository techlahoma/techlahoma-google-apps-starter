# Techlahoma Google Apps Starter - Environment Configuration

# Copy this file to .env (or apps/<app-slug>/.env / apps/<app-slug>/google.project.json)
# DO NOT commit .env or real credentials/project IDs to version control.

# ==============================================================================
# FIREBASE & GOOGLE CLOUD CONFIGURATION
# ==============================================================================

# Your unique Google Cloud / Firebase Project ID
# ------------------------------------------------------------------------------
# Project IDs are 6-30 characters long, containing lowercase letters, digits,
# or hyphens. Starts with a letter and ends with a letter or digit.
#
# Where to find or create your Project ID:
#   - Firebase Console: https://console.firebase.google.com/
#   - Google Cloud Console: https://console.cloud.google.com/
#
FIREBASE_PROJECT_ID=my-google-app-dev

# Display name for your Firebase / Google Cloud Project
FIREBASE_DISPLAY_NAME="My Google App"

# Deployment Environment: development | preview | production
FIREBASE_ENVIRONMENT=development

# Deployment Region (e.g., us-central1, us-east1, europe-west1)
FIREBASE_REGION=us-central1


# ==============================================================================
# QUICK INSTRUCTIONS / HOW TO USE
# ==============================================================================
#
# 1. Copy this template to create your root .env file:
#    cp .env.example .env
#
# 2. Open .env and set your FIREBASE_PROJECT_ID and FIREBASE_DISPLAY_NAME.
#
# 3. Apply your .env settings to your target app workspace (e.g. apps/welcome):
#    bun run google:config apply --app welcome
#
#    Note: You can also pass explicit overrides if needed:
#    bun run google:config apply --app welcome --project-id my-custom-id
#
# 4. Useful links & dashboards:
#    - Firebase Console:       https://console.firebase.google.com/
#    - Google Cloud Console:   https://console.cloud.google.com/
#    - Firebase Hosting Docs:  https://firebase.google.com/docs/hosting
#    - Firebase CLI Docs:      https://firebase.google.com/docs/cli
#
