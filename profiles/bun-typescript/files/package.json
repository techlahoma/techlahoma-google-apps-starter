{
  "name": "__PROJECT_SLUG__",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "biome format --write scripts tests",
    "format:check": "biome format scripts tests",
    "lint": "biome lint scripts tests && oxlint --max-warnings=0 scripts tests",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14",
    "oxlint": "1.64.0",
    "typescript": "5.9.3"
  }
}
