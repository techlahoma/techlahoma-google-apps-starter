{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    ".cache/",
    ".starter/",
    ".github/",
    "build/",
    "coverage/",
    "dist/",
    "docs/",
    "node_modules/",
    "packages/",
    "playwright-report/",
    "profiles/",
    "test-results/"
  ]
}
