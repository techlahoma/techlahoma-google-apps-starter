{
  "name": "__PROJECT_SLUG__-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check . && oxlint --max-warnings=0 .",
    "prepack": "bun run verify",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.14",
    "oxlint": "1.64.0",
    "publint": "0.3.21",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  }
}
