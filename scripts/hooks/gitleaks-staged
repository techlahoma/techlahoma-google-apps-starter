#!/usr/bin/env bash

set -euo pipefail

if git diff --cached --quiet --; then
  echo "gitleaks: no staged changes to scan"
  exit 0
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required. Install the pinned tool with: mise install" >&2
  exit 1
fi

gitleaks protect --staged --redact --no-banner
